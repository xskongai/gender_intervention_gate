# Target models. Set only the providers you plan to run.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

GEMINI_API_KEY=
GEMINI_MODEL=

DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash

QWEN_API_KEY=
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen3.7-plus

GLM_API_KEY=
GLM_MODEL=glm-5.2

# Optional OpenAI-compatible local server.
LOCAL_API_KEY=
LOCAL_MODEL=
LOCAL_BASE_URL=http://localhost:8000/v1

# The rewrite Judge always uses OPENAI_API_KEY with the fixed model gpt-4o.
